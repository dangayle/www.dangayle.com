---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <style>
    *, ::before, ::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif; }
    .page { max-width: 64rem; margin: 0 auto; padding: 1rem; line-height: 1.25; }
    h1 { margin: 0 0 1.5rem; font-size: 3rem; font-weight: normal; line-height: 1; }
    main { display: grid; gap: 1.5rem; }
    img { display: block; width: 100%; height: auto; margin-bottom: 1rem; }
    p { margin: 0; }
    ul { margin: 0 0 2rem; padding: 0; list-style: none; }
    li { margin-bottom: 1rem; }
    a { color: #2563eb; text-decoration: none; }
    a:hover { color: #000; text-decoration: underline; }
    @media (min-width: 768px) {
      .page { padding: 4rem; }
      main { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      section { grid-column: span 2; }
      li { margin-bottom: 0.5rem; }
    }
    .banner {
      display: block;
      padding: 0.75rem 1rem;
      background: #064e3b;
      color: #ecfdf5;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.9375rem;
      letter-spacing: 0.02em;
      text-align: center;
      text-decoration: none;
    }
    .banner:hover, .banner:focus {
      background: #065f46;
      color: #fff;
      text-decoration: none;
    }
    .banner:focus-visible { outline: 2px solid #ecfdf5; outline-offset: -5px; }
    .banner__dot {
      display: inline-block;
      width: 0.5rem;
      height: 0.5rem;
      margin-right: 0.5rem;
      border-radius: 50%;
      background: #34d399;
      vertical-align: 0.1em;
      animation: banner-pulse 2.5s ease-in-out infinite;
    }
    .banner__link { text-decoration: underline; text-underline-offset: 0.15em; }
    @keyframes banner-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; }
    }
    @media (prefers-reduced-motion: reduce) {
      .banner__dot { animation: none; }
    }
    .grow-on-hover {
      -moz-osx-font-smoothing: grayscale;
      backface-visibility: hidden;
      transform: translateZ(0);
      transition: transform 0.25s ease-out;
    }
    a.grow-on-hover { display: inline-block; transform-origin: left center; }
    .grow-on-hover:hover, .grow-on-hover:focus { transform: scale(1.05); }
    .grow-on-hover:active { transform: scale(0.9); }
  </style>
</head>
<body>
  <a class="banner" href="https://www.linkedin.com/in/dangayle" aria-label="Open for work. Connect with Daniel Gayle on LinkedIn.">
    <span class="banner__dot" aria-hidden="true"></span>#openforwork<span aria-hidden="true"> &rarr; </span><span class="banner__link">LinkedIn</span>
  </a>
  <div class="page">
    <header><h1>{{ title }}</h1></header>
    <main>
      <nav>
        <img class="grow-on-hover" src="/profile.jpg" alt="Daniel Gayle" width="600" height="600" fetchpriority="high">
        <p><a class="grow-on-hover" href="mailto:dangayle@gmail.com">Email me</a></p>
      </nav>
      <section>
        <ul>
          {%- for link in links %}
          <li><a class="grow-on-hover" href="{{ link.href }}">{{ link.text }}</a></li>
          {%- endfor %}
        </ul>
      </section>
    </main>
  </div>
</body>
</html>
